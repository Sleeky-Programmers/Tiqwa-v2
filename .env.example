# Booking backend (Tiqwa / Premium Whitelabel API v2).
# Leave TIQWA_API_URL unset to run the whole site on built-in demo data.
TIQWA_API_URL=''

# Public URL of this site. Sent to the backend as the Origin, which it uses to find your
# agency and to send travellers back to /verify-payment after paying.
APP_URL=http://localhost:4545

# Optional shared store for repeat-safe bookings and payments (Upstash Redis REST).
# Without it, duplicate requests are caught per server process, which is enough for a single
# server. Set both when running several instances (serverless, or more than one server).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
